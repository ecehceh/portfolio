{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Christopher Evan Wijaksana's developer portfolio — Next.js, Three.js and GSAP.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "docker:up": "docker compose up --build --detach --wait",
    "docker:down": "docker compose down",
    "docker:smoke": "bash scripts/docker-smoke.sh",
    "sync:credly": "node scripts/sync-credly.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-regular-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@fortawesome/react-fontawesome": "3.5.0",
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.1",
    "three": "0.149.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.149.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
